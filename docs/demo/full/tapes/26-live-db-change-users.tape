# SecureShift full walkthrough - clip 26: Live DB change - psql changes users while the app is open
# Every screen reads fresh from the database: a renamed user shows at once, a deactivated user is logged out at the next click
# Generated by docs/demo/full/clips.js (do not edit by hand); recorded by scripts/windows/record-full-demo.ps1
Output raw/26-live-db-change-users.mp4
Set Shell "powershell"
Set FontSize 25
Set Width 1920
Set Height 1080
Set Padding 24
Set TypingSpeed 70ms
Set Framerate 25

Hide
Type "$ProgressPreference = 'SilentlyContinue'; Set-Location C:\Demo\SecureShift; $env:ConnectionStrings__SecureShiftDb = Get-Content C:\SecureShiftTools\connection-string.txt; $env:PGPASSWORD = Get-Content C:\SecureShiftTools\postgres-password.txt; $psql = 'C:\SecureShiftTools\pgsql\bin\psql.exe'; Clear-Host"
Enter
Wait@60s />\s*$/
Show
Sleep 1s
Type "# A teammate changes the database with psql -f while SecureShift is open (every screen reads fresh)"
Enter
Wait@120s />\s*$/
Sleep 1s
Type `function Teammate($file, $seconds) { Start-Process -NoNewWindow powershell -ArgumentList '-NoProfile', '-Command', "Start-Sleep $seconds; & '$psql' -h 127.0.0.1 -p 5434 -U postgres -d secureshift -e -f $file; Write-Host -NoNewline '(psql done) '" }`
Enter
Wait@120s />\s*$/
Sleep 1s
Type "Get-Content C:\Demo\live\01-rename-user.sql"
Enter
Wait@120s />\s*$/
Sleep 2s
Type "Teammate C:\Demo\live\01-rename-user.sql 35"
Enter
Wait@120s />\s*$/
Sleep 0.5s
Type "dotnet app\SecureShift.Console.dll"
Enter
Wait@120s /Choose:\s*$/
Sleep 2s
Type "1"
Enter
Sleep 300ms
Wait@120s /Email:\s*$/
Sleep 2s
Type "arya.mujumdar@secureshift.io"
Enter
Sleep 300ms
Wait@120s /Password:\s*$/
Sleep 0.7s
Type "Super@2026"
Enter
Sleep 300ms
