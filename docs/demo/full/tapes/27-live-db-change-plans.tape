# SecureShift full walkthrough - clip 27: Live DB change - Legacy password hash, a plan decided by someone else
# An old SHA-256 password hash is upgraded at login; a plan approved in psql while the review is open cannot be rejected
# Generated by docs/demo/full/clips.js (do not edit by hand); recorded by scripts/windows/record-full-demo.ps1
Output raw/27-live-db-change-plans.mp4
Set Shell "powershell"
Set FontSize 25
Set Width 1920
Set Height 1080
Set Padding 24
Set TypingSpeed 70ms
Set Framerate 25

Hide
Type "$ProgressPreference = 'SilentlyContinue'; Set-Location C:\Demo\SecureShift; $env:ConnectionStrings__SecureShiftDb = Get-Content C:\SecureShiftTools\connection-string.txt; $env:PGPASSWORD = Get-Content C:\SecureShiftTools\postgres-password.txt; $psql = 'C:\SecureShiftTools\pgsql\bin\psql.exe'; Clear-Host"
Enter
Wait@60s />\s*$/
Show
Sleep 1s
Type "# 1. An old (SHA-256) password hash, like the original SQL Server seed data"
Enter
Wait@120s />\s*$/
Sleep 1s
Type "Get-Content C:\Demo\live\04-legacy-hash.sql"
Enter
Wait@120s />\s*$/
Sleep 2s
Type "& $psql -h 127.0.0.1 -p 5434 -U postgres -d secureshift -e -f C:\Demo\live\04-legacy-hash.sql"
Enter
Wait@120s />\s*$/
Sleep 2s
Type "# 2. Another executive approves PLAN-001 in psql while this review screen is open"
Enter
Wait@120s />\s*$/
Sleep 1s
Type `function Teammate($file, $seconds) { Start-Process -NoNewWindow powershell -ArgumentList '-NoProfile', '-Command', "Start-Sleep $seconds; & '$psql' -h 127.0.0.1 -p 5434 -U postgres -d secureshift -e -f $file; Write-Host -NoNewline '(psql done) '" }`
Enter
Wait@120s />\s*$/
Sleep 1s
Type "Get-Content C:\Demo\live\05-approve-plan.sql"
Enter
Wait@120s />\s*$/
Sleep 2s
Type "Teammate C:\Demo\live\05-approve-plan.sql 44"
Enter
Wait@120s />\s*$/
Sleep 0.5s
Type "dotnet app\SecureShift.Console.dll"
Enter
Wait@120s /Choose:\s*$/
Sleep 2s
Type "1"
Enter
Sleep 300ms
Wait@120s /Email:\s*$/
Sleep 2s
Type "shivanand.kumatekar@secureshift.io"
Enter
Sleep 300ms
Wait@120s /Password:\s*$/
Sleep 0.7s
Type "Exec@2026"
Enter
Sleep 300ms
Wait@120s /Choose:\s*$/
Sleep 3s
Type "1"
Enter
Sleep 300ms
Wait@120s /Choose:\s*$/
Sleep 2s
Type "1"
Enter
Sleep 300ms
Wait@120s /Choose:\s*$/
Sleep 1s
ScrollUp 27
Sleep 3s
ScrollDown 27
Sleep 2s
Wait@180s /psql done/
Sleep 2s
