# SecureShift full walkthrough - clip 00: Setup - Setup from zero with the offline package
# Only .NET 8 on the laptop: unzip, PostgreSQL zip from the pen drive, run.ps1, db status, smoke, login screen
# Generated by docs/demo/full/clips.js (do not edit by hand); recorded by scripts/windows/record-full-demo.ps1
Output raw/00-setup-offline-package.mp4
Set Shell "powershell"
Set FontSize 25
Set Width 1920
Set Height 1080
Set Padding 24
Set TypingSpeed 70ms
Set Framerate 25

Hide
Type "$ProgressPreference = 'SilentlyContinue'; Set-Location C:\Demo; Clear-Host"
Enter
Wait@60s />\s*$/
Show
Sleep 1s
Type "# SecureShift from zero: a laptop with only .NET 8 - no Git, no build, no internet, no admin rights"
Enter
Wait@120s />\s*$/
Sleep 1s
Type "dotnet --list-runtimes"
Enter
Wait@120s />\s*$/
Sleep 2s
Type "Get-ChildItem C:\Demo\PenDrive | Format-Table Name, Length -AutoSize"
Enter
Wait@120s />\s*$/
Sleep 2s
Type "Expand-Archive C:\Demo\PenDrive\SecureShift-offline.zip -DestinationPath C:\Demo"
Enter
Wait@300s />\s*$/
Sleep 1s
Type "Copy-Item C:\Demo\PenDrive\postgresql-16.11-1-windows-x64-binaries.zip C:\Demo\SecureShift"
Enter
Wait@120s />\s*$/
Sleep 1s
Type "cd C:\Demo\SecureShift"
Enter
Wait@120s />\s*$/
Sleep 0.5s
Type "Get-ChildItem | Format-Table Name, Length -AutoSize"
Enter
Wait@120s />\s*$/
Sleep 2s
Type "powershell -ExecutionPolicy Bypass -File run.ps1 -SetupOnly"
Enter
Wait@900s />\s*$/
Sleep 1s
ScrollUp 42
Sleep 3s
ScrollDown 30
Sleep 3s
ScrollDown 12
Sleep 2s
Type "$env:ConnectionStrings__SecureShiftDb = Get-Content C:\SecureShiftTools\connection-string.txt"
Enter
Wait@120s />\s*$/
Sleep 0.5s
Type "dotnet app\SecureShift.Console.dll db status"
Enter
Wait@120s />\s*$/
Sleep 1s
ScrollUp 23
Sleep 3s
ScrollDown 23
Sleep 2s
Type "dotnet app\SecureShift.Console.dll smoke"
Enter
Wait@120s />\s*$/
Sleep 3s
Type "powershell -ExecutionPolicy Bypass -File run.ps1"
Enter
Wait@300s /Choose:\s*$/
Sleep 1s
ScrollUp 5
Sleep 3s
ScrollDown 5
Sleep 2s
Type "0"
Enter
Wait@120s />\s*$/
Sleep 2s
Sleep 1s
