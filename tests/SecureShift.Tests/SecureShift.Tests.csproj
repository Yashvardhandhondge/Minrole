<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SecureShift.Tests (xUnit).
      Unit tests        : no database needed.
      Database tests    : need a seeded database. Set the env var ConnectionStrings__SecureShiftDb
                          (CI does this with a postgres:16 service). They never change data.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>SecureShift.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="8.0.34" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SecureShift.Console\SecureShift.Console.csproj" />
    <ProjectReference Include="..\..\src\SecureShift.Data\SecureShift.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
